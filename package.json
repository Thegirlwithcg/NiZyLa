{
  "name": "nizyla",
  "version": "0.1.1",
  "description": "NiZyLa - a graph-aware programming editor built with Node, Electron, and Svelte.",
  "homepage": "https://github.com/Thegirlwithcg/NiZyLa",
  "author": {
    "name": "nicha",
    "email": "nichadapatthana@gmail.com"
  },
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "nizyla": "bin/nizyla.js"
  },
  "files": [
    "bin/",
    "dist/",
    "electron/",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5174 && cross-env NIZYLA_DEV=1 electron . --in-process-gpu\"",
    "web": "vite --host 127.0.0.1",
    "test": "node --test test/*.test.js",
    "build": "vite build",
    "prepack": "npm run build",
    "start": "npm run build && electron .",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@codemirror/autocomplete": "latest",
    "@codemirror/commands": "latest",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "latest",
    "@codemirror/lang-html": "latest",
    "@codemirror/lang-javascript": "latest",
    "@codemirror/lang-json": "latest",
    "@codemirror/lang-markdown": "latest",
    "@codemirror/lang-python": "latest",
    "@codemirror/language": "latest",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "latest",
    "@codemirror/state": "latest",
    "@codemirror/view": "latest",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/svelte": "^1.6.6"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "svelte": "^5.57.0",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.thegirlwithcg.nizyla",
    "productName": "NiZyLa",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "icon": "resource/Logo NiZyLa.ico",
    "extraResources": [
      {
        "from": "resource",
        "to": "resource"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resource/Logo NiZyLa.png",
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resource/Logo NiZyLa.ico"
    },
    "mac": {
      "icon": "resource/Logo NiZyLa.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
